# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Whitelist: comma-separated Telegram user IDs
ALLOWED_TELEGRAM_IDS=123456789

# Browser: brave | chrome | chromium
BROWSER_TYPE=brave

# Opsional: path manual jika Brave tidak terdeteksi otomatis
# BROWSER_EXECUTABLE=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# false saat login manual, true untuk posting otomatis
BROWSER_HEADLESS=true

# Twitter cookies for scraping (export from browser DevTools: F12 -> Application -> Cookies -> x.com)
# Format: ct0=VALUE; auth_token=VALUE
TWITTER_COOKIES=

# Optional
DATA_DIR=./data
TEMP_DIR=./temp
MAX_PHOTO_SIZE_MB=20
MAX_REPLY_TEXT_LENGTH=280
